# Shared local worker settings
SESSION_SECRET=replace-with-a-local-session-secret
ALLOWED_ORIGINS=http://127.0.0.1:4173
LOCAL_DEV_STATE_PATH=.tmp/local-dev/worker-state.json

# Optional: require an unlock code before the web app can create an account session.
APP_UNLOCK_CODE=

# Local app mode
MOCK_BACKEND=true

# Safe root and optional allowlist for real mode / real validation.
NEXTCLOUD_ROOT_PATH=.davora-agent-test
# Leave empty to allow any valid Nextcloud host; set a comma-separated list only if you want an explicit restriction.
NEXTCLOUD_ALLOWED_HOSTS=

# Optional live-validation inputs used by `rtk npm run validate:real`.
NEXTCLOUD_BASE_URL=https://nextcloud.ownhost.top
NEXTCLOUD_USERNAME=ynvio
NEXTCLOUD_APP_PASSWORD=

# Optional limits
SESSION_TTL_SECONDS=3600
NEXTCLOUD_MAX_FILE_BYTES=65536
NEXTCLOUD_MAX_TEXT_FILE_BYTES=16384
VITE_OPENED_FILE_CACHE_LIMIT_BYTES=4194304

# Optional deploy settings used by root deploy scripts.
# `npm run deploy:web` defaults VITE_API_BASE_URL to the deployed Worker origin
# `https://davora.xyofn8h7t.workers.dev`; only override it when targeting a different Worker.
# `npm run deploy:web` also defaults CLOUDFLARE_PAGES_PROJECT_NAME to `davora`.
CLOUDFLARE_PAGES_PROJECT_NAME=
VITE_API_BASE_URL=
