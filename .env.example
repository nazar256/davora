# Shared local worker settings
# Development fixture only; production requires at least 32 raw bytes.
SESSION_SECRET=replace-with-a-local-session-secret
# Optional migration key. Provision a strong value before migrating an existing
# state encrypted by SESSION_SECRET.
ACCOUNT_STATE_SECRET=
# Optional separate signing key. Provision fresh random bytes here to invalidate
# sessions/stream tokens without changing encrypted account-state data.
SESSION_TOKEN_SECRET=
ALLOWED_ORIGINS=http://127.0.0.1:4173
LOCAL_DEV_STATE_PATH=.tmp/local-dev/worker-state.json

# Development-only unlock flow. Production rejects any non-empty APP_UNLOCK_CODE.
APP_UNLOCK_CODE=

# Local app mode
MOCK_BACKEND=true
RUNTIME_MODE=development
ALLOW_LOCAL_NEXTCLOUD=false

# Safe root and exact allowlist for real mode / real validation.
NEXTCLOUD_ROOT_PATH=.davora-agent-test
# Production real mode requires exact normalized hostnames, for example:
NEXTCLOUD_ALLOWED_HOSTS=nextcloud.ownhost.top

# Optional live-validation inputs used by `rtk npm run validate:real`.
NEXTCLOUD_BASE_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=

# Optional limits
SESSION_TTL_SECONDS=3600
NEXTCLOUD_MAX_FILE_BYTES=65536
NEXTCLOUD_MAX_TEXT_FILE_BYTES=16384
VITE_OPENED_FILE_CACHE_LIMIT_BYTES=4194304

# Optional deploy settings used by root deploy scripts.
# `npm run deploy:web` defaults VITE_API_BASE_URL to the deployed Worker origin
# `https://davora.xyofn8h7t.workers.dev`; only override it when targeting a different Worker.
# `npm run deploy:web` also defaults CLOUDFLARE_PAGES_PROJECT_NAME to `davora`.
CLOUDFLARE_PAGES_PROJECT_NAME=
VITE_API_BASE_URL=
