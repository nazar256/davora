{
  "name": "@davora/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:playwright": "playwright test",
    "test:e2e": "npm run test:playwright && npm run test:screenshots",
    "test:screenshots": "CAPTURE_SCREENSHOTS=true playwright test tests/screenshots.spec.ts",
    "test:pwa": "playwright test --config=playwright.pwa.config.ts"
  },
  "dependencies": {
    "@davora/shared": "1.0.0",
    "heic-to": "^1.5.2",
    "idb-keyval": "^6.2.1",
    "jszip": "^3.10.1",
    "markdown-it": "^14.1.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.0",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.1.0",
    "vite": "^5.4.19",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^3.2.4"
  }
}
