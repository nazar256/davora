{
  "name": "@davora/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage:pure": "vitest run --config vitest.pure-coverage.config.ts --coverage.enabled",
    "test:playwright": "playwright test && playwright test --config=playwright.dev.config.ts",
    "test:e2e": "npm run test:playwright && npm run test:screenshots",
    "test:screenshots": "CAPTURE_SCREENSHOTS=true playwright test tests/screenshots.spec.ts tests/preview-screenshots.spec.ts tests/operations-screenshots.spec.ts",
    "test:pwa": "playwright test --config=playwright.pwa.config.ts"
  },
  "dependencies": {
    "@davora/shared": "1.0.0",
    "idb-keyval": "^6.2.1",
    "jszip": "^3.10.1",
    "libheif-js": "^1.23.2",
    "lucide-react": "^1.24.0",
    "markdown-it": "^14.3.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.1.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
