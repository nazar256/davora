# Safe mock defaults for exact local `wrangler dev` smoke checks.
# Do not put real secrets in this file. Production deploys must configure
# real Worker vars/secrets in Cloudflare, and custom local overrides should
# use an ignored env file passed via `wrangler dev --env-file ...`.
SESSION_SECRET=davora-local-dev-session-secret
MOCK_BACKEND=true
SESSION_TTL_SECONDS=3600
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:4174,http://127.0.0.1:4175
NEXTCLOUD_ROOT_PATH=.davora-agent-test
